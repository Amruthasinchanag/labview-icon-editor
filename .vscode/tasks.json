{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Tooling: Verify IE Paths (g-cli)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\Tooling\\Invoke-MissingIEFilesFromLVInstall.ps1",
        "-MinimumSupportedLVVersion",
        "${input:lvVersion}",
        "-SupportedBitness",
        "${input:lvBitness}",
        "-ConnectTimeoutMs",
        "${input:lvConnectTimeoutMs}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "CI: Worktree + Parity (Clean Only)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\Tooling\\Invoke-CIParity-WorktreeClean.ps1",
        "-LabVIEWBitness",
        "${input:ciLabVIEWBitness}",
        "-WorktreeRoot",
        "C:\\dev",
        "-EnsureCleanState"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Worktrees: List",
      "type": "shell",
      "command": "git",
      "args": [
        "worktree",
        "list"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Worktrees: Prune",
      "type": "shell",
      "command": "git",
      "args": [
        "worktree",
        "prune"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Worktrees: Remove (Prompt Path)",
      "type": "shell",
      "command": "git",
      "args": [
        "worktree",
        "remove",
        "${input:ciWorktreeRemovePath}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "lvVersion",
      "type": "pickString",
      "description": "LabVIEW version for g-cli",
      "options": [
        "2020",
        "2021",
        "2022",
        "2023",
        "2024",
        "2025"
      ],
      "default": "2021"
    },
    {
      "id": "lvBitness",
      "type": "pickString",
      "description": "LabVIEW bitness",
      "options": [
        "32",
        "64"
      ],
      "default": "64"
    },
    {
      "id": "lvConnectTimeoutMs",
      "type": "promptString",
      "description": "g-cli connect timeout (ms)",
      "default": "120000"
    },
    {
      "id": "ciLabVIEWBitness",
      "type": "pickString",
      "description": "Parity bitness mode",
      "options": [
        "both",
        "installed",
        "64",
        "32"
      ],
      "default": "both"
    },
    {
      "id": "ciWorktreeRemovePath",
      "type": "promptString",
      "description": "Worktree path to remove (must be a worktree dir)",
      "default": "C:\\dev\\<worktree-folder>"
    }
  ]
}
